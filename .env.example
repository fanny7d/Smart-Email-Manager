# Runtime
SEM_ENVIRONMENT=development
SEM_LOG_LEVEL=INFO
SEM_API_HOST=127.0.0.1
SEM_API_PORT=8000

# Local Homebrew PostgreSQL. The empty authority uses the current macOS user
# and the local Unix socket. Override in production with a least-privilege role.
SEM_DATABASE_URL=postgresql+psycopg:///smart_email_manager_dev
# Optional alternative for Docker/Kubernetes/external secret mounts.
SEM_DATABASE_URL_FILE=

# Development bootstrap token. Generate a strong random value before exposing
# the API outside localhost. Empty is accepted only in development.
SEM_API_TOKEN=
SEM_API_TOKEN_FILE=

# Required before writing account secrets. Generate 32 random bytes encoded as
# URL-safe base64. Keep previous keys available during a future rotation.
SEM_MASTER_KEY=
SEM_MASTER_KEY_FILE=
SEM_MASTER_KEY_VERSION=1

# JSON array consumed by pydantic-settings.
SEM_CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL-backed worker
SEM_WORKER_ID=local-worker-1
SEM_WORKER_POLL_SECONDS=2
SEM_JOB_LEASE_SECONDS=60
