SEM_LOG_LEVEL=INFO
SEM_PUBLIC_ORIGIN=http://localhost:8080
SEM_WEB_BIND=127.0.0.1:8080

# Use independent URL-safe random values. Percent-encode database passwords if
# they contain URL-reserved characters.
SEM_BOOTSTRAP_DB_PASSWORD=replace-with-bootstrap-password
SEM_MIGRATOR_DB_PASSWORD=replace-with-migrator-password
SEM_APP_DB_PASSWORD=replace-with-runtime-password
SEM_API_TOKEN=replace-with-strong-api-token
# Prefer *_FILE paths when secrets are mounted by Docker/Kubernetes.
# SEM_API_TOKEN_FILE=/run/secrets/sem_api_token

# python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
SEM_MASTER_KEY=replace-with-urlsafe-base64-32-byte-key
# SEM_MASTER_KEY_FILE=/run/secrets/sem_master_key
# SEM_DATABASE_URL_FILE=/run/secrets/sem_database_url
SEM_MASTER_KEY_VERSION=1

SEM_WORKER_ID=compose-worker-1
SEM_WORKER_POLL_SECONDS=2
SEM_JOB_LEASE_SECONDS=60
